#!/usr/bin/env bash
#
# The review lifecycle, driven for real against the herdr in test/bin.
#
# That stub keeps a session in files, which is what makes the one state a
# live server cannot be asked for testable: two callers claiming the same
# workspace at the same instant.  Its on-claim hook injects a competing
# claim at the moment the script makes its own.
#
# Every test gets a fresh session holding one workspace, w1, whose root
# pane is w1:p1 and which has no review.  A failing test leaves its
# session directory behind, named in the failure, so what the script did
# to it can be read afterwards.
#
# Usage: test/run [NAME-SUBSTRING]

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
readonly ROOT
readonly REVIEW="$ROOT/bin/herdr-meat-review"

PATH="$ROOT/test/bin:$PATH"
export PATH

passed=0
failed=0
current=
current_failed=
WATCHER=

# Assertions -----------------------------------------------------------------

fail() {
  # Counted per test rather than per assertion, so that one broken thing
  # reads as one failure however many assertions notice it.
  [ -n "$current_failed" ] || printf '  FAILED  %s\n' "$current"
  current_failed=1
  printf '          %s\n' "$@"
}

assert_equal() {
  local expected=$1 actual=$2 what=${3:-value}
  [ "$expected" = "$actual" ] ||
    fail "$what" "expected: $expected" "actual:   $actual"
}

assert_contains() {
  local haystack=$1 needle=$2 what=${3:-output}
  case $haystack in
    *"$needle"*) ;;
    *) fail "$what does not contain: $needle" "actual: $haystack" ;;
  esac
}

# The session under test -----------------------------------------------------

setup() {
  HERDR_STUB_STATE=$(mktemp -d "${TMPDIR:-/tmp}/herdr-meat-review-XXXXXX")
  export HERDR_STUB_STATE
  # Not inherited from whatever pane the suite was started in.  These two
  # decide which workspace a review lands in and which agent it wakes, so a
  # run inside a herdr pane would otherwise exercise different behaviour than
  # one outside it -- and the pane it named would be a real agent.
  unset HERDR_PANE_ID HERDR_WORKSPACE_ID
  printf 'w1:p1 w1:t1 w1 /repo\n' >"$HERDR_STUB_STATE/panes"
  printf 'w1 w1:t1 project\n' >"$HERDR_STUB_STATE/workspaces"
}

teardown() {
  # A review left running would hold the next test's stub state open, and a
  # blocking TUI would hold the suite itself.  Whatever the test did or
  # failed to do, the review ends here.
  if [ -n "$WATCHER" ]; then
    take_the_review_away
    wait "$WATCHER" 2>/dev/null || true
    WATCHER=
  fi
  if [ -n "$current_failed" ]; then
    printf '          session left at %s\n' "$HERDR_STUB_STATE"
  else
    rm -rf "$HERDR_STUB_STATE"
  fi
}

claim_hook() {
  # Make the stub claim PANE for someone else the moment the script
  # claims: another caller got in between the check and the claim.
  # Interpreted by the bash running this suite, not by whatever
  # /usr/bin/env finds — inside a nix build there is no /usr/bin/env, and a
  # hook that will not run makes the race silently untested.
  local pane=$1
  cat >"$HERDR_STUB_STATE/on-claim" <<EOF
#!$BASH
grep -qxF '$pane' "\$HERDR_STUB_STATE/claims" ||
  printf '%s\n' '$pane' >>"\$HERDR_STUB_STATE/claims"
EOF
  chmod +x "$HERDR_STUB_STATE/on-claim"
}

state_file() {
  cat "$HERDR_STUB_STATE/$1" 2>/dev/null | tr '\n' ' ' | sed 's/ $//'
}

# A repository to review ------------------------------------------------------

repo() {
  # A git repository at the workspace's directory, so the marker the
  # review leaves behind has somewhere to live.  Two commits, so there is
  # history to slice.
  #
  # NAME makes a second one, for a test contrasting two checkouts.  Only the
  # first becomes the workspace's directory: the second exists to be somewhere
  # the asking pane is not.
  local name=${1:-repo} dir
  dir=$HERDR_STUB_STATE/$name
  mkdir -p "$dir"
  git -C "$dir" init -q -b main
  git -C "$dir" config user.email test@example.com
  git -C "$dir" config user.name Test
  printf 'one\n' >"$dir/file"
  git -C "$dir" add -A
  git -C "$dir" commit -qm one
  [ -n "${1:-}" ] ||
    printf 'w1:p1 w1:t1 w1 %s\n' "$dir" >"$HERDR_STUB_STATE/panes"
  printf '%s\n' "$dir"
}

commit_in() {
  local dir=$1 message=$2
  printf '%s\n' "$message" >>"$dir/file"
  git -C "$dir" add -A
  git -C "$dir" commit -qm "$message"
}

host_command() {
  # What the pane was told to run, which carries the tuicr arguments.
  grep '^pane run ' "$HERDR_STUB_STATE/log" | tail -1
}

# A reviewer, driven a comment at a time -------------------------------------
#
# The watcher reads a live review through the tuicr stub, which answers out
# of these files.  A test writes them in the order a reviewer would produce
# them, so what is under test is the watcher's reading of a session that
# changes underneath it.

review_registers() {
  printf 'true\n' >"$HERDR_STUB_STATE/session-active"
  printf '[]\n' >"$HERDR_STUB_STATE/session-comments"
}

reviewer_says() {
  # Append comments, each with an id of its own, in one write.  One write
  # because the watcher is running: three separate ones are three chances
  # for it to look in between, and what is under test here is what it does
  # with what it finds, not how fast a test can call jq.
  local file=$HERDR_STUB_STATE/session-comments existing
  existing=$(cat "$file" 2>/dev/null || printf '[]')
  printf '%s' "$existing" |
    jq --args '. as $had
       | reduce $ARGS.positional[] as $text ($had;
           . + [{id: "c\(length)", location: "review", content: $text,
                 created_at: "2026-01-01T00:00:00Z"}])' "$@" >"$file.new"
  mv "$file.new" "$file"
}

reviewer_says_elsewhere() {
  # A comment in the other session of the same checkout, which is not this
  # review and must not reach this review's agent.
  local file=$HERDR_STUB_STATE/other-session-comments
  jq -n --arg text "$1" \
    '[{id: "x0", location: "review", content: $text,
       created_at: "2026-01-02T00:00:00Z"}]' >"$file"
}

reviewer_quits() {
  printf 'false\n' >"$HERDR_STUB_STATE/session-active"
}

# Intervals small enough that a test does not wait for a real reviewer.
# `env' rather than a prefix on the command, because the callers below put
# this in front of things that are not simple commands.
BRISK=(env HERDR_MEAT_REVIEW_POLL_SECONDS=0.05 HERDR_MEAT_REVIEW_QUIET_POLLS=2)

host_in_background() {
  # The pane side of a review, with a TUI that stays up until the reviewer
  # quits.  This is where the closing wake comes from, so a test about the
  # end of a review has to go through it rather than through the watcher.
  #
  # Runs in DIRECTORY when one is given, because in a real review the pane's
  # working directory is the one the tab was created on, and that is what the
  # host watches and names in its wakes.
  local dir=${1:-$PWD}
  touch "$HERDR_STUB_STATE/tui-blocks"
  ( cd "$dir" && exec "${BRISK[@]}" "$REVIEW" host w1:t1 w1:p2 --notify w1:p1 ) &
  WATCHER=$!
  settle
}

take_the_review_away() {
  # What a closing tab does to a pane: the script is signalled and the TUI
  # in it dies.  Both, and in that order, because bash runs an EXIT trap
  # only once the foreground child has returned — signalling the script
  # alone would leave it waiting on a TUI that nobody had told to stop.
  kill -TERM "$WATCHER" 2>/dev/null || true
  touch "$HERDR_STUB_STATE/tui-killed"
}

watch_in_background() {
  "${BRISK[@]}" "$REVIEW" watch --notify w1:p1 --cwd /repo &
  WATCHER=$!
  # Let it find the session and take stock of what is in it.  A comment
  # written before it has done that is one it will read as belonging to an
  # earlier round, which is the behaviour a test has to set up for
  # deliberately rather than trip over.
  settle
}

polls_taken() {
  local marks
  marks=$(cat "$HERDR_STUB_STATE/polls" 2>/dev/null || printf '')
  printf '%s\n' "${#marks}"
}

settle() {
  # Wait for the watcher to have looked, several times over, rather than
  # for a length of time.  A sleep long enough here on one machine is too
  # short on a busier one, and the failure it produces reads as a bug in
  # the watcher.
  #
  # Four by default, which covers the poll that sees a comment arrive and
  # the QUIET_POLLS after it that decide the reviewer has stopped.
  local want=$(( $(polls_taken) + ${1:-4} )) waited=0
  while [ "$(polls_taken)" -lt "$want" ]; do
    # A watcher that died will never poll again, and waiting for it to is
    # the hang this bound exists to turn into a failure.
    if ! kill -0 "$WATCHER" 2>/dev/null; then
      fail "the watcher is gone after $(polls_taken) polls"
      return 0
    fi
    sleep 0.05
    waited=$((waited + 1))
    [ "$waited" -lt 200 ] || { fail "the watcher stopped polling"; return 0; }
  done
}

wait_for_watcher() {
  # The watcher returns when the review goes away.  One that never notices
  # would hang the suite, so it is given a bound and the failure is named:
  # a watcher still running after the review ended is the bug, not the wait.
  local waited=0
  while kill -0 "$WATCHER" 2>/dev/null; do
    sleep 0.05
    waited=$((waited + 1))
    if [ "$waited" -ge 200 ]; then
      fail "the review ended and the watcher is still running"
      return 0
    fi
  done
  wait "$WATCHER" 2>/dev/null || true
}

prompts() {
  grep '^agent prompt ' "$HERDR_STUB_STATE/log" 2>/dev/null || true
}

wakes_about_new_comments() {
  prompts | grep -c 'new review comment' || true
}

# Tests ----------------------------------------------------------------------

test_open_puts_the_review_in_a_tab_of_its_own() {
  # Claiming before the pane runs anything is what makes the workspace's
  # one review slot taken from the moment the tab appears.
  local reply
  reply=$("$REVIEW" open --workspace w1)
  assert_equal w1:p2 "$(printf '%s' "$reply" | jq -r .pane_id)" "pane"
  assert_equal false "$(printf '%s' "$reply" | jq -r .reused)" "reused"
  assert_equal w1:p2 "$(state_file claims)" "claims"
  assert_equal "report-agent w1:p2" "$(head -1 "$HERDR_STUB_STATE/log")" \
    "claimed before running anything"
  assert_contains "$(sed -n 2p "$HERDR_STUB_STATE/log")" "pane run w1:p2" "run"
}

test_open_goes_to_the_review_already_open() {
  # A workspace holds one review, so a second request is a jump.
  "$REVIEW" open --workspace w1 >/dev/null
  local reply
  reply=$("$REVIEW" open --workspace w1)
  assert_equal w1:p2 "$(printf '%s' "$reply" | jq -r .pane_id)" "pane"
  assert_equal true "$(printf '%s' "$reply" | jq -r .reused)" "reused"
  assert_equal w1:p2 "$(state_file claims)" "claims"
  assert_contains "$(state_file log)" "agent focus w1:p2" "log"
  # The caller needs this to find the review session afterwards, and
  # cannot know whether it opened the review or was sent to one.
  assert_equal /repo "$(printf '%s' "$reply" | jq -r .cwd)" "cwd"
}

test_open_stands_down_when_it_loses_the_race() {
  # The check cannot be trusted, because another caller can pass it in
  # the same instant, so the claim is verified after it is made and
  # everyone but the oldest claim gives its tab back.
  claim_hook w1:p1
  local reply
  reply=$("$REVIEW" open --workspace w1)
  assert_equal w1:p1 "$(printf '%s' "$reply" | jq -r .pane_id)" "pane"
  assert_equal true "$(printf '%s' "$reply" | jq -r .reused)" "reused"
  assert_equal w1:p1 "$(state_file claims)" "claims"
  assert_equal "w1:p1 w1:t1 w1 /repo" "$(state_file panes)" "panes"
  assert_contains "$(state_file log)" "tab close w1:t2" "log"
}

test_open_hands_tuicr_its_own_arguments() {
  # What follows -- is tuicr's, so a review is not always the worktree.
  "$REVIEW" open --workspace w1 -- --revisions 'HEAD~3..HEAD' >/dev/null
  assert_contains "$(state_file log)" "revisions" "log"
}

test_open_accepts_a_pane_id_past_the_ninth() {
  # herdr's public ids are base 36: the pane after w1:p9 is w1:pA.  A
  # check that only allowed digits rejected herdr's own answer, and the
  # tenth pane of a workspace could not be reviewed.
  printf '10\n' >"$HERDR_STUB_STATE/next"
  local reply
  reply=$("$REVIEW" open --workspace w1)
  assert_equal w1:pA "$(printf '%s' "$reply" | jq -r .pane_id)" "pane"
  assert_equal w1:pA "$(state_file claims)" "claims"
}

test_open_marks_what_it_showed() {
  # The marker is what makes the next review incremental, so it has to be
  # left behind without being asked for.
  local dir
  dir=$(repo)
  "$REVIEW" open --workspace w1 >/dev/null
  assert_equal "$(git -C "$dir" rev-parse HEAD)" \
    "$(git -C "$dir" rev-parse refs/reviews/1)" "marker"
}

test_open_shows_only_what_arrived_since_the_last_review() {
  # The whole point: a second review is about the work done after the
  # first, not the branch again.
  local dir
  dir=$(repo)
  "$REVIEW" open --workspace w1 >/dev/null
  "$REVIEW" close --workspace w1 >/dev/null
  commit_in "$dir" two
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" '--revisions refs/reviews/1..HEAD' \
    "range"
  assert_equal "$(git -C "$dir" rev-parse HEAD)" \
    "$(git -C "$dir" rev-parse refs/reviews/2)" "second marker"
}

test_open_measures_a_first_review_against_the_default_branch() {
  # There is no marker before the first review, and falling back to the
  # working tree alone made that review empty for anyone who did as they
  # were told and committed first.  The branch point is the next best
  # answer to "what has this branch got that main has not".
  #
  # main moves after the branch is cut, because the branch point and the
  # branch tip are the same commit until it does — and against the tip
  # every file main gained since reaches the reviewer as a deletion.
  local dir branch_point
  dir=$(repo)
  git -C "$dir" checkout -q -b feature
  commit_in "$dir" two
  branch_point=$(git -C "$dir" rev-parse HEAD~1)
  git -C "$dir" checkout -q main
  commit_in "$dir" elsewhere
  git -C "$dir" checkout -q feature
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" "$branch_point..HEAD" "range"
}

test_open_asks_the_remote_which_branch_is_the_default_one() {
  # Where origin says, that is the answer, whatever the branch is called.
  # trunk is cut from main and then moves, so the two candidates give
  # different branch points and the answer says which one was asked.
  local dir
  dir=$(repo)
  git -C "$dir" checkout -q -b trunk
  commit_in "$dir" on-trunk
  git -C "$dir" update-ref refs/remotes/origin/trunk HEAD
  git -C "$dir" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/trunk
  git -C "$dir" checkout -q -b feature
  commit_in "$dir" two
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" "$(git -C "$dir" rev-parse trunk)..HEAD" \
    "range"
  case "$(host_command)" in
    *"$(git -C "$dir" rev-parse main)"*) fail "main was used, not origin's HEAD" ;;
  esac
}

test_open_finds_a_default_branch_that_is_not_called_main() {
  # No origin to ask, and a repository whose default branch git would have
  # named `develop'.  Guessing only main and master left it with no branch
  # point, which is the empty first review all over again.
  local dir
  dir=$(repo)
  git -C "$dir" config init.defaultBranch develop
  git -C "$dir" branch -q -m develop
  git -C "$dir" checkout -q -b feature
  commit_in "$dir" two
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" "$(git -C "$dir" rev-parse develop)..HEAD" \
    "range"
}

test_open_ignores_a_marker_left_on_another_branch() {
  # refs/reviews lives in the common git directory, so every branch and
  # every linked worktree shares the counter.  A marker naming a commit
  # this branch does not contain would show the other branch's work as a
  # deletion — worse than the empty review, because it looks like a review.
  local dir branch_point
  dir=$(repo)
  git -C "$dir" checkout -q -b other
  commit_in "$dir" other-work
  "$REVIEW" open --workspace w1 >/dev/null
  "$REVIEW" close --workspace w1 >/dev/null
  git -C "$dir" checkout -q main
  git -C "$dir" checkout -q -b feature
  branch_point=$(git -C "$dir" rev-parse HEAD)
  commit_in "$dir" mine
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" "$branch_point..HEAD" "range"
  case "$(host_command)" in
    *refs/reviews/1*) fail "a marker from another branch was used" ;;
  esac
}

test_open_says_when_the_review_it_opened_is_empty() {
  # tuicr quits at once when it is given nothing, taking the tab with it.
  # A caller reading only "reused": false would report a review waiting
  # that had already gone.
  local dir reply
  dir=$(repo)
  reply=$("$REVIEW" open --workspace w1)
  assert_equal true "$(printf '%s' "$reply" | jq -r .empty)" "empty"
  assert_equal 'nothing to review' \
    "$(printf '%s' "$reply" | jq -r .summary)" "summary"
  printf 'dirty\n' >"$dir/file"
  "$REVIEW" close --workspace w1 >/dev/null
  reply=$("$REVIEW" open --workspace w1)
  assert_equal false "$(printf '%s' "$reply" | jq -r .empty)" "not empty"
}

test_open_on_the_default_branch_has_no_branch_point_to_use() {
  # main's merge-base with main is main, so there is no range and the
  # review is the working tree.  Naming the whole history instead would
  # make a first review unreadable in any repository with a past.
  local dir
  dir=$(repo)
  commit_in "$dir" two
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" '--working-tree' "working tree"
  case "$(host_command)" in
    *--revisions*) fail "the default branch was reviewed against itself" ;;
  esac
}

test_open_prefers_the_last_marker_to_the_branch_point() {
  # Once a review has happened the marker is the better answer: a second
  # review is about the work done since the first, not since the branch
  # point again.
  local dir
  dir=$(repo)
  git -C "$dir" checkout -q -b feature
  commit_in "$dir" two
  "$REVIEW" open --workspace w1 >/dev/null
  "$REVIEW" close --workspace w1 >/dev/null
  commit_in "$dir" three
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" 'refs/reviews/1..HEAD' "range"
}

test_open_shows_the_working_tree_when_nothing_was_committed() {
  # Nothing can record that uncommitted work was seen, so an empty range
  # is left out rather than passed to tuicr as HEAD..HEAD.
  local dir
  dir=$(repo)
  "$REVIEW" open --workspace w1 >/dev/null
  "$REVIEW" close --workspace w1 >/dev/null
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" '--working-tree' "working tree"
  case "$(host_command)" in
    *--revisions*) fail "an empty range was passed to tuicr" ;;
  esac
}

test_open_lets_given_arguments_win() {
  # Naming a range means that range. The marker still moves, because the
  # work was still put in front of someone.
  local dir
  dir=$(repo)
  "$REVIEW" open --workspace w1 -- --all-files >/dev/null
  assert_contains "$(host_command)" '--all-files' "arguments"
  case "$(host_command)" in
    *--revisions*) fail "a computed range overrode the given arguments" ;;
  esac
  assert_equal "$(git -C "$dir" rev-parse HEAD)" \
    "$(git -C "$dir" rev-parse refs/reviews/1)" "marker"
}

test_open_outside_a_repository_still_works() {
  # /repo is not a checkout in the default fixture, and a review of a
  # directory git knows nothing about must still open.
  "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" '--working-tree' "working tree"
}

test_host_counts_the_range_it_is_showing() {
  # The row tells the operator what they are being asked to look at, so a
  # review of a range has to count that range.  Counting the working tree
  # regardless reports a number belonging to work nobody asked about.
  local dir
  dir=$(repo)
  commit_in "$dir" two
  printf 'a\n' >"$dir/untracked-one"
  printf 'b\n' >"$dir/untracked-two"
  (cd "$dir" && "$REVIEW" host w1:t1 w1:p1 -- --revisions 'HEAD~1..HEAD')
  assert_contains "$(state_file log)" "summary=1 file to review" "summary"
}

test_host_counts_the_working_tree_when_that_is_what_it_shows() {
  # And hands tuicr the same selector the count was taken from, so that
  # the row and the TUI are answering for one review.
  local dir
  dir=$(repo)
  printf 'a\n' >"$dir/untracked-one"
  printf 'b\n' >"$dir/untracked-two"
  (cd "$dir" && "$REVIEW" host w1:t1 w1:p1)
  assert_contains "$(state_file log)" "summary=2 files to review" "summary"
  assert_contains "$(state_file log)" "tuicr --working-tree" "tuicr"
}

test_host_counts_a_file_once_however_many_selectors_reach_it() {
  # A file committed in the range and edited again since is one file to
  # read, not two.  The name has a space in it because `git status' quotes
  # such a path and every other git command prints it plain: counting the
  # working tree out of porcelain made the two selectors disagree about
  # what the file is called, and the file counted twice.
  local dir
  dir=$(repo)
  git -C "$dir" mv file 'my file'
  git -C "$dir" commit -qm rename
  printf 'two\n' >>"$dir/my file"
  git -C "$dir" commit -qam two
  printf 'more\n' >>"$dir/my file"
  (cd "$dir" && "$REVIEW" host w1:t1 w1:p1 -- --revisions 'HEAD~1..HEAD' \
                                              --working-tree)
  assert_contains "$(state_file log)" "summary=1 file to review" "summary"
}

test_host_counts_every_tracked_file_from_the_root() {
  # -A reviews the whole repository, so a review opened in a subdirectory
  # counts the whole repository.  `git ls-files' answers about the current
  # directory unless told otherwise, and would have counted the subtree.
  local dir
  dir=$(repo)
  mkdir -p "$dir/sub"
  printf 'nested\n' >"$dir/sub/nested"
  git -C "$dir" add -A
  git -C "$dir" commit -qm nested
  (cd "$dir/sub" && "$REVIEW" host w1:t1 w1:p1 -- --all-files)
  assert_contains "$(state_file log)" "summary=2 files to review" "summary"
}

test_host_gives_no_count_for_a_selector_git_cannot_measure() {
  # tuicr's --file opens a path with no VCS involved.  Counting git for it
  # answers zero, which reads as "nothing to review" when there is.
  local dir
  dir=$(repo)
  (cd "$dir" && "$REVIEW" host w1:t1 w1:p1 -- --file notes.md)
  assert_contains "$(state_file log)" "summary=review waiting" "summary"
}

test_host_gives_no_count_when_git_cannot_answer() {
  # A range that does not resolve, and a directory git knows nothing
  # about, both leave the count untaken.  Reporting zero would say the
  # reviewer has nothing to read.
  local dir
  dir=$(repo)
  (cd "$dir" && "$REVIEW" host w1:t1 w1:p1 -- --revisions 'typo..HEAD')
  assert_contains "$(state_file log)" "summary=review waiting" "range"
  (cd "$HERDR_STUB_STATE" && "$REVIEW" host w1:t1 w1:p1 -- --working-tree)
  assert_contains "$(state_file log)" "summary=review waiting" "no repository"
}

test_host_survives_a_selector_missing_its_value() {
  # `-r' with nothing after it is a mistake, not a crash: under `set -u'
  # an unguarded $2 puts a bash error in the operator's pane.
  local dir output
  dir=$(repo)
  output=$( (cd "$dir" && "$REVIEW" host w1:t1 w1:p1 -- --revisions) 2>&1 )
  assert_contains "$(state_file log)" "summary=review waiting" "summary"
  case $output in
    *"unbound variable"*) fail "the selector walk crashed" "$output" ;;
  esac
}

test_open_tells_the_host_which_agent_asked() {
  # The agent that asked for the review is the one to wake when comments
  # arrive, and the only moment it can be identified is while its own
  # request is being served.  herdr puts the pane in the environment of
  # everything it starts.
  HERDR_PANE_ID=w1:p1 "$REVIEW" open --workspace w1 >/dev/null
  assert_contains "$(host_command)" '--notify w1:p1' "notify"
}

test_open_names_no_agent_when_a_person_asked() {
  # A review opened from the Emacs panel has no agent behind it, and a
  # watcher with nobody to tell is a poll that helps no one.
  HERDR_PANE_ID='' "$REVIEW" open --workspace w1 >/dev/null
  case "$(host_command)" in
    *--notify*) fail "a review nobody asked for got a watcher" ;;
  esac
}

test_watch_wakes_the_agent_once_for_a_burst_of_comments() {
  # A reviewer writing four comments is one thing to be told about, not
  # four.  Waking per comment would spend a turn of the agent's attention
  # on each, and the reviewer is still typing.
  review_registers
  watch_in_background
  reviewer_says one two three
  settle
  reviewer_quits
  wait_for_watcher
  assert_equal 1 "$(wakes_about_new_comments)" "wakes about comments"
  assert_contains "$(prompts)" "3 new review comments" "count"
}

test_watch_ignores_comments_an_earlier_round_already_showed() {
  # tuicr reuses a session when the same range is reviewed again, so the
  # comments of the last round are already in it when this one opens.
  # Announcing what is there at the start would replay the whole review.
  review_registers
  reviewer_says "said last time"
  watch_in_background
  settle
  reviewer_quits
  wait_for_watcher
  assert_equal 0 "$(wakes_about_new_comments)" "announced an old comment"
}

test_host_wakes_the_agent_when_the_review_closes() {
  # The signal that replaces "check the review": the reviewer quit, so
  # there is nothing more coming and the agent can act.
  review_registers
  host_in_background
  reviewer_says "please rename this"
  settle
  reviewer_quits
  wait_for_watcher
  assert_contains "$(prompts)" "review is closed" "closing wake"
  assert_contains "$(prompts)" "1 comment in total" "count"
}

test_host_counts_the_whole_session_when_the_review_closes() {
  # Whatever was held back — never announced because the agent was busy,
  # or written in the moment before the watcher took stock — is in the
  # session, and the closing count is taken from the session.  So nothing
  # a reviewer wrote can go unmentioned.
  printf 'working\n' >"$HERDR_STUB_STATE/agent-status"
  review_registers
  host_in_background
  reviewer_says one two
  settle
  assert_equal 0 "$(wakes_about_new_comments)" "woke a working agent"
  reviewer_quits
  wait_for_watcher
  assert_contains "$(prompts)" "2 comments in total" "count"
}

test_host_wakes_the_agent_when_the_review_is_taken_away() {
  # `close' ends a review the operator walked away from, and a tab closing
  # takes the pane with it.  The agent was told to wait for a wake, so the
  # wake has to survive the review ending without the reviewer.
  review_registers
  host_in_background
  reviewer_says "half a thought"
  settle
  take_the_review_away
  wait_for_watcher
  assert_contains "$(prompts)" "review is closed" "closing wake"
}

test_host_says_so_when_the_reviewer_had_nothing_to_say() {
  # Silence is a verdict, and the agent cannot tell it from a review that
  # never happened unless it is told.
  review_registers
  host_in_background
  reviewer_quits
  wait_for_watcher
  assert_contains "$(prompts)" "review is closed" "closing wake"
  assert_contains "$(prompts)" "no comments" "silence"
}

test_host_says_so_when_the_review_never_opened() {
  # tuicr quits at once when it is given nothing, and a tuicr that is not
  # on PATH never draws at all.  Either way no session registers, and an
  # agent told to wait for a wake would wait for ever.
  "${BRISK[@]}" HERDR_MEAT_REVIEW_SESSION_POLLS=2 \
    "$REVIEW" host w1:t1 w1:p2 --notify w1:p1
  assert_contains "$(prompts)" "no session registered" "closing wake"
  assert_contains "$(prompts)" "Do not wait" "what to do about it"
  assert_equal 0 "$(wakes_about_new_comments)" "invented comments"
}

test_watch_waits_for_an_agent_that_is_working() {
  # Prompting an agent mid-turn interrupts the work the review was about.
  # The comments keep until it is listening.
  printf 'working\n' >"$HERDR_STUB_STATE/agent-status"
  review_registers
  watch_in_background
  reviewer_says "a note"
  settle
  assert_equal 0 "$(wakes_about_new_comments)" "prompted a working agent"
  printf 'idle\n' >"$HERDR_STUB_STATE/agent-status"
  settle
  assert_contains "$(prompts)" "1 new review comment" "told once idle"
  reviewer_quits
  wait_for_watcher
}

test_watch_holds_comments_it_could_not_deliver() {
  # A wake that did not land must not be recorded as sent: those comments
  # would then be missing from every later wake, and the agent would be
  # told about work it had never seen.
  printf 'refuse\n' >"$HERDR_STUB_STATE/prompt-fails"
  review_registers
  watch_in_background
  reviewer_says "a note"
  settle
  rm -f "$HERDR_STUB_STATE/prompt-fails"
  settle
  reviewer_quits
  wait_for_watcher
  assert_contains "$(prompts)" "1 new review comment" "retried once it could"
}

test_watch_follows_the_session_it_was_started_for() {
  # A checkout can hold more than one session, and another one going live
  # is not this review.  Following whichever was written to last reported
  # somebody else's comments to this review's agent.
  review_registers
  watch_in_background
  printf 'true\n' >"$HERDR_STUB_STATE/other-session-active"
  reviewer_says_elsewhere "not your review"
  settle
  assert_equal 0 "$(wakes_about_new_comments)" "announced another session"
  reviewer_quits
  wait_for_watcher
}

test_watch_gives_up_when_no_review_ever_registers() {
  # tuicr quits at once when it is given nothing, so a session may never
  # appear.  The watcher must not outlive the review it was watching.
  "${BRISK[@]}" HERDR_MEAT_REVIEW_SESSION_POLLS=3 \
    "$REVIEW" watch --notify w1:p1 --cwd /repo
  assert_equal 3 "$(polls_taken)" "looked for a session"
  assert_equal "" "$(prompts)" "woke someone about a review that never was"
}

test_marks_lists_what_has_been_reviewed() {
  local dir
  dir=$(repo)
  "$REVIEW" open --workspace w1 >/dev/null
  local reply
  reply=$("$REVIEW" marks "$dir")
  assert_equal 1 "$(printf '%s' "$reply" | jq -r '.marks | length')" "count"
  assert_equal "$(git -C "$dir" rev-parse HEAD)" \
    "$(printf '%s' "$reply" | jq -r '.head')" "head"
}

test_open_refuses_without_a_workspace() {
  local output
  output=$(HERDR_WORKSPACE_ID='' "$REVIEW" open 2>&1)
  assert_equal 1 "$?" "exit status"
  assert_contains "$output" "no workspace" "complaint"
}

test_close_gives_the_pane_and_the_tab_back() {
  # Ending a review frees the workspace to hold the next one.
  "$REVIEW" open --workspace w1 >/dev/null
  local reply
  reply=$("$REVIEW" close --workspace w1)
  assert_equal true "$(printf '%s' "$reply" | jq -r .closed)" "closed"
  assert_equal "" "$(state_file claims)" "claims"
  assert_contains "$(state_file log)" "release-agent w1:p2" "log"
}

test_close_says_so_when_there_is_nothing_to_close() {
  # A caller cleaning up after an operator who walked away cannot know
  # whether they quit the TUI first.
  local reply
  reply=$("$REVIEW" close --workspace w1)
  assert_equal false "$(printf '%s' "$reply" | jq -r .closed)" "closed"
}

test_status_answers_empty_until_a_review_is_open() {
  # An empty object is how a caller learns the operator is done.
  assert_equal "{}" "$("$REVIEW" status --workspace w1 | jq -c .)" "before"
  "$REVIEW" open --workspace w1 >/dev/null
  assert_equal review \
    "$("$REVIEW" status --workspace w1 | jq -r .agent)" "after"
}

# Which checkout, and whose review ------------------------------------------
#
# Two things decide where a review lands: the directory it is opened on, and
# the pane it wakes.  Both were taken on trust, and each failed in a way that
# left the agent confidently wrong rather than stuck.

subdirectory_of() {
  # A directory inside the checkout, which is where an agent works in a
  # monorepo and therefore what it passes as --cwd.
  local dir=$1/packages/thing
  mkdir -p "$dir"
  printf '%s\n' "$dir"
}

session_filed_under() {
  # Make the tuicr stub answer only to DIRECTORY, as the real one does: it
  # files a session against the top of the working tree and matches --repo
  # against that exact path.
  printf '%s\n' "$1" >"$HERDR_STUB_STATE/session-repo"
}

test_open_reports_the_checkout_a_subdirectory_belongs_to() {
  # What a caller is told to keep, and hand back to tuicr later.  tuicr files
  # a session under the top of the working tree and answers only to that
  # path, so the subdirectory the review was opened on is of no use to anyone
  # trying to find it again.
  local dir sub reply
  dir=$(repo)
  sub=$(subdirectory_of "$dir")
  reply=$("$REVIEW" open --workspace w1 --cwd "$sub")
  assert_equal "$dir" "$(printf '%s' "$reply" | jq -r .cwd)" "reported cwd"
}

test_open_opens_the_review_on_the_directory_it_was_given() {
  # Only the reported path is resolved.  The pane's working directory is what
  # tuicr resolves its own arguments against, so moving it up to the root
  # would silently repoint every relative path a caller passed.
  local dir sub
  dir=$(repo)
  sub=$(subdirectory_of "$dir")
  "$REVIEW" open --workspace w1 --cwd "$sub" >/dev/null
  assert_contains "$(state_file panes)" "w1:p2 w1:t2 w1 $sub" "the pane's directory"
}

test_watch_finds_a_session_filed_against_the_checkout_root() {
  # The review pane sits in the subdirectory the review was opened on, and
  # tuicr answers only to the root it filed the session under.  A watcher that
  # searches the pane's own directory finds nothing, announces no comment, and
  # reports at the close that the review never opened -- while a person is
  # reading it.
  local dir sub
  dir=$(repo)
  sub=$(subdirectory_of "$dir")
  session_filed_under "$dir"
  review_registers
  host_in_background "$sub"
  reviewer_says "please rename this"
  settle
  assert_equal 1 "$(wakes_about_new_comments)" "wake about the comment"
  reviewer_quits
  wait_for_watcher
  assert_contains "$(prompts)" "1 comment in total" "closing count"
}

test_open_leaves_a_directory_git_knows_nothing_about_alone() {
  # Resolving to the top of a working tree cannot become a requirement to be
  # in one: a review of a plain directory still opens.
  local plain reply
  plain=$HERDR_STUB_STATE/plain
  mkdir -p "$plain"
  reply=$("$REVIEW" open --workspace w1 --cwd "$plain")
  assert_equal "$plain" "$(printf '%s' "$reply" | jq -r .cwd)" "reported cwd"
}

test_open_does_not_wake_an_agent_about_another_checkout() {
  # The pane to wake comes from the environment and the thing to review from
  # --cwd, so nothing about a request makes them agree.  A wake carries a
  # session file rather than a repository, so a review of someone else's
  # project reaches an agent reading exactly like its own.
  local other reply
  repo >/dev/null                     # the checkout the asking pane works in
  other=$(repo other)
  reply=$(HERDR_PANE_ID=w1:p1 "$REVIEW" open --workspace w1 --cwd "$other")
  assert_equal false "$(printf '%s' "$reply" | jq -r .notified)" "notified"
  case "$(host_command)" in
    *--notify*) fail "an agent was bound to a review of another checkout" ;;
  esac
}

test_open_still_wakes_the_pane_that_was_named_outright() {
  # The guard above second-guesses an environment variable nobody set on
  # purpose.  A caller that names a pane has said what it means.
  local other
  repo >/dev/null
  other=$(repo other)
  HERDR_PANE_ID=w1:p1 "$REVIEW" open --workspace w1 --cwd "$other" \
    --notify w1:p1 >/dev/null
  assert_contains "$(host_command)" '--notify w1:p1' "notify"
}

test_open_wakes_an_agent_whose_pane_is_in_a_linked_worktree() {
  # A worktree has a top of its own, so comparing working trees would drop
  # the wake for every agent that had moved into one -- which is the ordinary
  # way of working on a branch.  What is compared is the shared git
  # directory, which a worktree keeps.
  local dir tree
  dir=$(repo)
  tree=$HERDR_STUB_STATE/linked
  git -C "$dir" worktree add -q --detach "$tree" HEAD
  printf 'w1:p1 w1:t1 w1 %s\n' "$tree" >"$HERDR_STUB_STATE/panes"
  HERDR_PANE_ID=w1:p1 "$REVIEW" open --workspace w1 --cwd "$dir" >/dev/null
  assert_contains "$(host_command)" '--notify w1:p1' "notify"
}

test_open_wakes_an_agent_reviewing_a_directory_outside_any_checkout() {
  # Either side being outside a repository proves nothing about the other,
  # and a wake dropped on a guess costs the reviewer their reply.
  local plain
  repo >/dev/null
  plain=$HERDR_STUB_STATE/plain
  mkdir -p "$plain"
  HERDR_PANE_ID=w1:p1 "$REVIEW" open --workspace w1 --cwd "$plain" >/dev/null
  assert_contains "$(host_command)" '--notify w1:p1' "notify"
}

test_open_wakes_an_agent_working_in_a_subdirectory_of_the_review() {
  # The guard compares checkouts, not paths.  An agent working deep in a
  # monorepo is working on the review it just asked for.
  local dir sub
  dir=$(repo)
  sub=$(subdirectory_of "$dir")
  printf 'w1:p1 w1:t1 w1 %s\n' "$sub" >"$HERDR_STUB_STATE/panes"
  HERDR_PANE_ID=w1:p1 "$REVIEW" open --workspace w1 --cwd "$dir" >/dev/null
  assert_contains "$(host_command)" '--notify w1:p1' "notify"
}

# What the agent is told -----------------------------------------------------

test_host_names_the_checkout_when_the_review_closes() {
  # A wake that names only a session file cannot be told from one meant for
  # another project, because the file name says nothing about either.
  local dir
  dir=$(repo)
  review_registers
  host_in_background "$dir"
  reviewer_says "looks good"
  settle
  reviewer_quits
  wait_for_watcher
  assert_contains "$(prompts)" "$dir" "the checkout the review was of"
}

test_host_names_the_checkout_it_searched_when_no_session_registered() {
  # The message names the directory it searched and no cause.  A session filed
  # under another path is indistinguishable from one that was never drawn, so
  # any cause it named would be a guess -- and this is the message that decides
  # whether an agent stops waiting for a reviewer.
  local dir
  dir=$(repo)
  ( cd "$dir" && exec "${BRISK[@]}" HERDR_MEAT_REVIEW_SESSION_POLLS=2 \
      "$REVIEW" host w1:t1 w1:p2 --notify w1:p1 )
  assert_contains "$(prompts)" "$dir" "the checkout it searched"
}

# Running them ---------------------------------------------------------------

main() {
  local filter=${1:-} name
  for name in $(declare -F | awk '{print $3}' | grep '^test_' | sort); do
    case $name in
      *"$filter"*) ;;
      *) continue ;;
    esac
    current=${name#test_}
    current_failed=
    setup
    "$name"
    teardown
    if [ -n "$current_failed" ]; then
      failed=$((failed + 1))
    else
      passed=$((passed + 1))
    fi
  done
  printf '\n%d passed, %d failed\n' "$passed" "$failed"
  [ "$failed" -eq 0 ]
}

main "$@"
