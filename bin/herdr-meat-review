#!/usr/bin/env bash
#
# herdr-meat-review — run a tuicr review as a first-class herdr agent.
#
# A review lives in its own tab of the workspace being reviewed, labelled
# "review", and reports itself to herdr as an agent of kind "review" in the
# blocked state.  herdr rolls that state up to the tab and the workspace, so
# a waiting review reaches every herdr client without any of them knowing
# what tuicr is.
#
# A workspace holds at most one review.  Asking for a second focuses the
# first, because two reviews of one checkout is more than an operator can
# hold at once.
#
# When the operator quits the tuicr TUI the review releases its agent
# authority and closes its tab, freeing the slot.
#
# With no tuicr arguments, a review shows what has arrived since the last
# one: each review leaves a marker under refs/reviews/<n>, and the next
# starts there.  Before there is a marker it uses the branch point, or on
# the default branch what has not been pushed.
#
# Committed work only.  A working repository is dirty nearly all the time,
# and what is dirty in it is rarely the change under review, so showing it
# would spend the reviewer's attention on unrelated files every round.
# Commit before asking; a review with nothing committed reports itself
# empty and says so.
#
# A review opened from an agent's pane watches itself, and wakes that agent
# when the reviewer writes something and again when the review closes.  So
# the operator never has to carry the message.
#
# Usage:
#   herdr-meat-review open   [--workspace ID] [--cwd DIR] [--focus]
#                            [--no-notify] [--notify PANE] [-- TUICR-ARG...]
#   herdr-meat-review close  [--workspace ID]
#   herdr-meat-review status [--workspace ID]
#   herdr-meat-review marks  [DIR]
#   herdr-meat-review watch  --notify PANE [--cwd DIR]
#   herdr-meat-review host   TAB PANE [--notify PANE] [-- TUICR-ARG...]
#                            (internal; runs in the pane)
#   herdr-meat-review version
#
# Every subcommand prints one JSON object on stdout; `watch' and `version'
# print a bare line.

set -euo pipefail

# The work, not the tool doing it: a client reading this back wants to
# know a review is waiting, not which TUI drew it, and swapping tuicr for
# something else should not reach any of them.  Not configurable, because
# herdr.el reads the same string and one of the two would always be free
# to disagree.
readonly AGENT_KIND=review
readonly SOURCE="custom:herdr-meat-review"
readonly TAB_LABEL=review

# How often the watcher asks tuicr what the reviewer has written, and how
# many of those answers must be unchanged before it wakes the agent.
#
# Counted in polls rather than seconds so that one knob moves the pace of
# everything: the suite drives a whole review in under a second by making
# the poll short, and the quiet window follows it down.
#
# Seven quiet polls is about fifteen seconds, which is longer than the gap
# between two comments of one thought and shorter than a reviewer's patience.
readonly POLL_SECONDS=${HERDR_MEAT_REVIEW_POLL_SECONDS:-2}
readonly QUIET_POLLS=${HERDR_MEAT_REVIEW_QUIET_POLLS:-7}

# How long to wait for tuicr to register a session before deciding it never
# will.  It quits at once when given nothing to show, and a watcher for a
# review that never opened must not outlive the pane.
readonly SESSION_POLLS=${HERDR_MEAT_REVIEW_SESSION_POLLS:-15}

self() {
  # Resolved so the pane runs this same file, whatever PATH it has.  By
  # hand rather than with `readlink -f', which is GNU-only.
  local path=${BASH_SOURCE[0]} target
  while [ -L "$path" ]; do
    target=$(readlink "$path")
    case $target in
      /*) path=$target ;;
      *) path=$(dirname "$path")/$target ;;
    esac
  done
  printf '%s\n' "$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")"
}

valid_id() {
  # herdr's public ids, which are interpolated into the exit trap below
  # and into a command the pane's shell runs.  What follows the letter is
  # base 36 rather than decimal — the pane after w1:p9 is w1:pA — so
  # anything alphanumeric has to pass.
  [[ $1 =~ ^w[0-9A-Za-z]+:[pt][0-9A-Za-z]+$ ]]
}

die() {
  printf 'herdr-meat-review: %s\n' "$*" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH"
}

version() {
  # Read rather than baked in, from the one file that carries the number.
  # `bin/..' is the repository root in a checkout and the package root once
  # installed, because the script keeps its place under bin/ in both.
  #
  # A caller comparing versions needs an answer even from a tree that has no
  # VERSION file, and a tool that refused to start over its own label would be
  # worse than one that admits it does not know.
  local file
  file=$(dirname "$(self)")/../VERSION
  if [ -r "$file" ]; then
    tr -d '[:space:]' <"$file"
    printf '\n'
  else
    printf 'unknown\n'
  fi
}

usage() {
  # To the end of the header block rather than to a word in it: a range that
  # ends on a phrase stops at the first line carrying it, so a sentence that
  # grows a second line loses it silently.
  printf 'herdr-meat-review %s\n\n' "$(version)"
  sed -n '/^# Usage:/,/^$/p' "$(self)" | sed 's/^# \{0,1\}//'
}

# Resolving what to act on ----------------------------------------------------

workspace_of() {
  # The workspace named on the command line, else the one this process runs
  # in.  herdr injects the latter into every pane it starts.
  local given=$1
  printf '%s\n' "${given:-${HERDR_WORKSPACE_ID:-}}"
}

SNAPSHOT=

snapshot() {
  # Read once per run.  A subcommand asks several questions of the tree
  # and wants one answer to all of them, not a tree that moved between
  # the pane it found and the tab that pane is in.
  [ -n "$SNAPSHOT" ] || SNAPSHOT=$(herdr api snapshot)
  printf '%s\n' "$SNAPSHOT"
}

review_panes() {
  # Every pane in WORKSPACE reporting itself as a review, oldest first.
  # herdr hands out pane ids in creation order, so the first is the
  # review that got there first.
  local workspace=$1
  snapshot | jq -r --arg ws "$workspace" --arg kind "$AGENT_KIND" '
    .result.snapshot.agents[]
    | select(.workspace_id == $ws and .agent == $kind)
    | .pane_id' | sort -V
}

review_pane() {
  # The pane hosting WORKSPACE's review, or nothing.
  local workspace=$1
  review_panes "$workspace" | head -1
}

tab_of_pane() {
  local pane=$1
  snapshot | jq -r --arg pane "$pane" '
    first(.result.snapshot.panes[]
          | select(.pane_id == $pane)
          | .tab_id) // empty'
}

workspace_cwd() {
  # Where the workspace is checked out: the working directory of the first
  # pane of its active tab, which is what herdr names the workspace after.
  local workspace=$1
  snapshot | jq -r --arg ws "$workspace" '
    (.result.snapshot.workspaces[] | select(.workspace_id == $ws) | .active_tab_id)
    as $tab
    | first(.result.snapshot.panes[] | select(.tab_id == $tab) | .cwd) // empty'
}

# What has already been reviewed --------------------------------------------
#
# Each review leaves a marker at the commit it was opened on, under
# refs/reviews/<n>.  The next review starts there, so a reviewer reads what
# arrived since they last looked instead of the whole branch again.
#
# Before there is a marker to start from, the branch point does the same
# job: what this branch has that the default one does not.  Which matters
# because the operator is told to commit before asking for a review, and
# without it doing so produced a review with nothing in it.
#
# The markers track commits only.  Uncommitted work is shown every time,
# because nothing can record that it was seen; commit before asking for a
# review and the marker can do its job.

git_repo() {
  git -C "$1" rev-parse --git-dir >/dev/null 2>&1
}

git_root() {
  # The top of the working tree holding DIRECTORY, or nothing when it is not
  # in one.  Nothing is an ordinary answer: a review of a plain directory is
  # allowed, and must not be turned into a requirement to be in a checkout.
  #
  # This is the path tuicr files a session under, so it is what has to be
  # asked for when looking one up again.
  git -C "$1" rev-parse --show-toplevel 2>/dev/null || true
}

git_identity() {
  # What project DIRECTORY belongs to, for deciding whether two directories
  # are the same work.  The shared git directory rather than the working
  # tree, because a linked worktree has a top of its own and is still the
  # same project -- an agent that has moved into one is working on exactly
  # what it asked to have reviewed.
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null ||
    true
}

last_mark() {
  # The highest-numbered marker, which is the last review shown, or
  # nothing before the first review.  Nothing is an ordinary answer, and
  # `grep' saying so must not fail the pipeline under `pipefail'.
  local dir=$1
  git -C "$dir" for-each-ref --format='%(refname)' refs/reviews 2>/dev/null |
    sed 's|^refs/reviews/||' |
    grep -E '^[0-9]+$' |
    sort -n |
    tail -1 || true
}

mark_reviewed() {
  # Record what this review is showing.  Done when the review opens rather
  # than when it closes: what it marks is that the work was put in front of
  # someone, which is true the moment the tab appears.
  local dir=$1 last next
  git_repo "$dir" || return 0
  git -C "$dir" rev-parse --verify -q HEAD >/dev/null || return 0
  last=$(last_mark "$dir")
  next=$(( ${last:-0} + 1 ))
  git -C "$dir" update-ref "refs/reviews/$next" HEAD
  printf '%s\n' "$next"
}

is_ancestor() {
  local dir=$1 maybe=$2 descendant=$3
  git -C "$dir" merge-base --is-ancestor "$maybe" "$descendant" 2>/dev/null
}

default_branch() {
  # What a branch is measured against before any review has happened.
  #
  # origin's own HEAD first, because that is the remote's own answer where
  # somebody has one.  Only `git clone' sets it, so a repository that
  # started local and gained a remote has none, and the rest is guesswork:
  # the name git would have made, then the two it is nearly always one of.
  local dir=$1 name
  name=$(git -C "$dir" symbolic-ref --quiet --short \
    refs/remotes/origin/HEAD 2>/dev/null) || name=
  if [ -n "$name" ]; then
    printf '%s\n' "$name"
    return 0
  fi
  local -a candidates=(main master)
  name=$(git -C "$dir" config --get init.defaultBranch 2>/dev/null) || name=
  [ -z "$name" ] || candidates=("$name" "${candidates[@]}")
  for name in "${candidates[@]}"; do
    if git -C "$dir" rev-parse --verify -q "refs/heads/$name" >/dev/null; then
      printf '%s\n' "$name"
      return 0
    fi
  done
  return 1
}

branch_point() {
  # Where this branch left the default one, which is the honest answer to
  # "what is here that has not been seen" when no marker has recorded it.
  #
  # The merge base rather than the branch tip, because the range is read
  # as a diff: against the tip, every file the default branch gained since
  # would reach the reviewer as a deletion.
  local dir=$1 base
  base=$(default_branch "$dir") || return 1
  git -C "$dir" merge-base HEAD "$base" 2>/dev/null
}

upstream_point() {
  # What this branch has that its remote does not.
  #
  # This is the answer on the default branch, where there is no branch
  # point: main's merge base with main is main's own tip, so nothing is
  # ever between them.  Plenty of work is done straight on the default
  # branch, and for that work "not yet pushed" is exactly "not yet seen".
  local dir=$1
  git -C "$dir" rev-parse --verify -q '@{upstream}' 2>/dev/null
}

same_commit() {
  local dir=$1
  [ "$(git -C "$dir" rev-parse "$2" 2>/dev/null)" = \
    "$(git -C "$dir" rev-parse "$3" 2>/dev/null)" ]
}

review_start() {
  # Where this review begins: the newest thing already seen.
  #
  # The marker, but only where it is behind HEAD.  `refs/reviews' lives in
  # the common git directory, so it is shared by every branch and every
  # linked worktree of the repository — a marker left on another branch
  # names a commit this one does not contain, and a range from there shows
  # that branch's work as a deletion.
  #
  # A marker behind HEAD but older than the branch point is still the
  # right answer, not the branch point: what lies between them is default
  # branch work that landed after the last review, and nobody has read
  # that either.
  local dir=$1 last point
  last=$(last_mark "$dir")
  if [ -n "$last" ] && is_ancestor "$dir" "refs/reviews/$last" HEAD; then
    printf '%s\n' "refs/reviews/$last"
    return 0
  fi

  # The branch point, where there is one that is not simply HEAD.
  point=$(branch_point "$dir") || point=
  if [ -n "$point" ] && ! same_commit "$dir" "$point" HEAD; then
    printf '%s\n' "$point"
    return 0
  fi

  # On the default branch there is no point of departure, so fall back to
  # what has not been pushed.  Checked for ancestry like the marker above:
  # a remote that has moved ahead names a commit this branch does not
  # contain, and a range from there reads as a deletion.
  point=$(upstream_point "$dir") || return 1
  same_commit "$dir" "$point" HEAD && return 1
  is_ancestor "$dir" "$point" HEAD || return 1
  printf '%s\n' "$point"
}

unreviewed_args() {
  # The tuicr arguments for everything not yet reviewed, one per line.
  #
  # Committed work only.  A working repository is dirty nearly all the
  # time, and what is dirty in it is almost never the change being
  # reviewed: a scratch file, an unrelated experiment, a half-finished
  # edit somewhere else entirely.  Sending those to a reviewer makes them
  # work out which parts they were meant to read, and they pay that on
  # every round because nothing can record that uncommitted work was seen.
  #
  # So the change under review is whatever has been committed for it.  That
  # is a demand on the caller -- commit before asking -- and the empty
  # review below is what tells them they have not.
  #
  # A review that comes out empty is left empty rather than widened: the
  # caller reports that, and showing the whole history instead would make
  # a first review unreadable in any repository with a past.
  local dir=$1 from
  if ! git_repo "$dir" || ! git -C "$dir" rev-parse --verify -q HEAD >/dev/null
  then
    # Nothing has ever been committed here, so there is no history to be
    # confused with and nothing else to show.
    printf -- '--working-tree\n'
    return 0
  fi
  from=$(review_start "$dir") || from=
  if [ -n "$from" ]; then
    printf -- '--revisions\n%s..HEAD\n' "$from"
    return 0
  fi
  # Nothing new is committed.  Name the empty range rather than passing no
  # selector at all: tuicr is given something it can measure, and the
  # review reports itself empty instead of falling open on the whole tree.
  printf -- '--revisions\nHEAD..HEAD\n'
}

dirty_tree() {
  local dir=$1
  git_repo "$dir" || return 1
  [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]
}

review_files() {
  # The files each selector puts in front of the reviewer, one per line and
  # repeated across selectors.  Every path is asked for the same way — from
  # the root of the repository, and never through `git status', whose
  # porcelain quotes a path with a space that the other commands print
  # plain, so that one file would read as two.
  #
  # Fails when nothing measurable was named, and when git could not answer.
  # Both are the same thing to a caller: nobody counted, which is not the
  # same as counting nothing.
  local directory=$1 measured=1
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      -r | --revisions)
        [ $# -ge 2 ] || return 1
        git -C "$directory" diff --name-only "$2" 2>/dev/null || return 1
        measured=0
        shift 2
        ;;
      -w | --working-tree)
        git -C "$directory" diff --name-only HEAD 2>/dev/null || return 1
        git -C "$directory" ls-files --others --exclude-standard \
          --full-name -- :/ 2>/dev/null || return 1
        measured=0
        shift
        ;;
      -A | --all-files)
        git -C "$directory" ls-files --full-name -- :/ 2>/dev/null || return 1
        measured=0
        shift
        ;;
      # tuicr takes selectors git cannot measure — `--file' opens a path
      # with no repository involved — and they add no files to the count.
      *) shift ;;
    esac
  done
  return $measured
}

changed_summary() {
  # What the operator is being asked to look at, for the panel row.  Counted
  # from git rather than from tuicr, because no review session exists yet,
  # and from the same selectors tuicr was given — a review of a range that
  # counted the working tree would report a number about other work.  No
  # file counts twice, however many selectors reach it.
  #
  # A count nobody could take is left unsaid rather than reported as zero,
  # which would read as "nothing to review" when there is.
  local directory=$1 files count
  shift
  files=$(review_files "$directory" "$@") || {
    printf 'review waiting\n'
    return 0
  }
  count=$(printf '%s' "$files" | sort -u | grep -c . || true)
  case $count in
    "" | 0) printf 'nothing to review\n' ;;
    1) printf '1 file to review\n' ;;
    *) printf '%s files to review\n' "$count" ;;
  esac
}

# Watching a review as it is written ------------------------------------------
#
# tuicr writes every comment to its session file the moment the reviewer
# presses Enter, and reports that session as active for as long as its TUI
# is up.  So a review can be read while it is happening, and the agent that
# asked for it can be told without the operator carrying the message.
#
# Two things are worth waking an agent for: comments arriving, and the
# review closing.  The first is a prefetch — the agent reads and plans while
# the reviewer is still reading, and edits nothing, because the reviewer is
# looking at the very files it would change.  The second is the go-ahead.
#
# The watcher below sends the first.  It never sends the second, because a
# review can end without it: `close' takes the tab away, and the watcher
# goes with it.  So the closing wake belongs to the pane's exit path, which
# runs however the review ended — see release_host.
#
# Everything here goes through tuicr's own commands rather than its store,
# so where a session is kept stays tuicr's business.

live_session() {
  # The session file of the review running in DIRECTORY, or nothing if none
  # is.  Asked once, to bind the watcher to one session: a checkout can hold
  # more than one, and a watcher that asked again each time would follow
  # whichever was written to last — reporting another workspace's review to
  # this review's agent.
  local directory=$1
  tuicr review list --repo "$directory" 2>/dev/null |
    jq -r 'map(select(.active == true))
           | sort_by(.updated_at)
           | if length == 0 then "" else last.path end' 2>/dev/null || true
}

session_is_live() {
  # Whether the session this watcher bound to is still being reviewed.
  local directory=$1 session=$2
  tuicr review list --repo "$directory" 2>/dev/null |
    jq -e --arg path "$session" \
      'any(.[]; .path == $path and .active == true)' >/dev/null 2>&1
}

comment_ids() {
  # Every comment in the session, oldest first.  Ids rather than contents,
  # because what the watcher needs is which ones it has not seen.
  local session=$1
  tuicr review comments --session "$session" 2>/dev/null |
    jq -r '.[].id' 2>/dev/null || true
}

ids_not_in() {
  # The ids of CURRENT that KNOWN does not have.
  local current=$1 known=$2
  [ -n "$current" ] || return 0
  [ -n "$known" ] || { printf '%s\n' "$current"; return 0; }
  printf '%s\n' "$current" | grep -vxF "$known" || true
}

count_lines() {
  [ -n "$1" ] || { printf '0\n'; return 0; }
  printf '%s\n' "$1" | grep -c . || true
}

agent_status() {
  local pane=$1
  herdr agent get "$pane" 2>/dev/null |
    jq -r '.result.agent.agent_status // "unknown"' 2>/dev/null || printf unknown
}

wake() {
  # Tell the agent, and say whether it was told.  Failure is not fatal — the
  # review is the operator's, and an agent that has gone away must not take
  # the reviewer's pane with it — but a caller that records what it has
  # announced has to know a message did not land.
  local pane=$1 message=$2
  herdr agent prompt "$pane" "$message" >/dev/null 2>&1
}

comment_word() {
  [ "$1" = 1 ] && printf 'comment\n' || printf 'comments\n'
}

await_session() {
  # The session tuicr registers when its TUI comes up, or nothing if it
  # never does — an empty review quits at once, and a review of a directory
  # tuicr keeps no session for never has one.
  local directory=$1 polls=0 session=''
  while [ "$polls" -lt "$SESSION_POLLS" ]; do
    session=$(live_session "$directory")
    [ -z "$session" ] || break
    sleep "$POLL_SECONDS"
    polls=$((polls + 1))
  done
  printf '%s\n' "$session"
}

cmd_watch() {
  local notify='' directory='' record=''
  while [ $# -gt 0 ]; do
    case $1 in
      --notify) notify=${2:?--notify needs a pane id}; shift 2 ;;
      --cwd) directory=${2:?--cwd needs a directory}; shift 2 ;;
      --session-file) record=${2:?--session-file needs a path}; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done

  require herdr
  require jq
  require tuicr
  [ -n "$notify" ] || die "watch needs --notify"
  valid_id "$notify" || die "not a pane id: $notify"
  [ -n "$directory" ] || directory=$PWD

  # Searched for by the path tuicr files a session under -- see git_root.  The
  # review pane's own directory is the one the review was opened on, which in
  # a monorepo is a subdirectory, and asking about that finds nothing however
  # long a reviewer spends in the session.
  local root
  root=$(git_root "$directory")
  [ -z "$root" ] || directory=$root

  local session
  session=$(await_session "$directory")
  [ -n "$session" ] || return 0

  # Told to whoever is waiting for the review to end, which needs the path
  # and cannot ask for it once the session is no longer the live one.
  [ -z "$record" ] || printf '%s\n' "$session" >"$record"

  # Seed with what is already there.  tuicr reuses a session when the same
  # range is reviewed again, so the comments of the last round are in it
  # before this one starts, and announcing them would replay the review.
  #
  # This reads the session one poll after tuicr registered it, so a comment
  # written in that gap is taken for an old one and never announced as new.
  # The closing wake counts every comment in the session, so it still
  # reaches the agent.  The gap is the time it takes a reviewer to read a
  # diff they have not seen, so nothing is expected to arrive in it.
  local announced outstanding='' previous='' quiet=0
  announced=$(comment_ids "$session")

  while session_is_live "$directory" "$session"; do
    outstanding=$(ids_not_in "$(comment_ids "$session")" "$announced")
    if [ "$outstanding" = "$previous" ]; then
      quiet=$((quiet + 1))
    else
      quiet=0
      previous=$outstanding
    fi

    # Wait for the reviewer to stop typing, so a burst of comments is one
    # interruption.  And never while the agent is working: a prompt
    # submitted mid-turn interrupts the work the review is about.  Held
    # comments are not lost — they stay outstanding, and the closing wake
    # counts the whole session however little of it was announced.
    if [ -n "$outstanding" ] && [ "$quiet" -ge "$QUIET_POLLS" ] &&
       [ "$(agent_status "$notify")" != working ]; then
      local new
      new=$(count_lines "$outstanding")
      if wake "$notify" "$new new review $(comment_word "$new") on the change \
you asked to have reviewed in $directory. Read them with: tuicr review \
comments --session $session — the reviewer is still reading, so understand \
them and plan, but do not edit yet. Hand the turn back when you have read \
them."; then
        # Only once it landed.  Recording an undelivered message as
        # announced would hide those comments from every later wake.
        announced=$(printf '%s\n%s\n' "$announced" "$outstanding" | grep . || true)
        outstanding=''
        previous=''
        quiet=0
      fi
    fi
    sleep "$POLL_SECONDS"
  done
}

wake_closed() {
  # The wake that replaces the operator saying "check the review".  Sent
  # from the pane's exit path, so that it goes out however the review ended
  # — the reviewer quitting, `close', or the tab being taken away.
  local pane=$1 session=$2 directory=$3
  [ -n "$pane" ] || return 0

  # Named in every wake, because a session path is an opaque file name: an
  # agent woken about another project's review cannot tell it from its own
  # until it opens the session and reads what is inside.
  local what="The review of $directory"

  # An unregistered session has two possible causes -- nothing was ever drawn,
  # or a session exists under a path other than the one searched -- and
  # nothing here can tell them apart.  Every way of asking tuicr returns the
  # same empty answer.  So the message names the directory it searched and
  # claims nothing about why: this is what decides whether an agent stops
  # waiting, and a guess it cannot check is worse than no reason at all.
  if [ -z "$session" ]; then
    wake "$pane" "$what ended with no session registered for that directory, \
so there are no comments to read and none are coming. Do not wait. Tell the \
user, and ask what to review." || true
    return 0
  fi

  local total
  total=$(count_lines "$(comment_ids "$session")")
  if [ "$total" = 0 ]; then
    wake "$pane" "$what is closed with no comments. The reviewer read the \
change and had nothing to say." || true
    return 0
  fi
  wake "$pane" "$what is closed, with $total $(comment_word "$total") in \
total. Read them with: tuicr review comments --session $session — then \
address them in new commits." || true
}

# Subcommands -----------------------------------------------------------------

cmd_open() {
  # The agent that asked is the one to wake when the reviewer writes
  # something.  herdr puts the pane id into the environment of everything
  # it starts, so a request made from an agent's own pane identifies it
  # without the agent having to know its own name.  A review opened from
  # the Emacs panel or a plain shell has no agent behind it, and gets no
  # watcher.
  local workspace='' directory='' focus=--no-focus
  # `named' separates a pane the caller asked for from one the environment
  # supplied.  Only the second is second-guessed below: a caller that names a
  # pane has said what it means and is owed it.
  local notify=${HERDR_PANE_ID:-} named=''
  while [ $# -gt 0 ]; do
    case $1 in
      --workspace) workspace=${2:?--workspace needs an id}; shift 2 ;;
      --cwd) directory=${2:?--cwd needs a directory}; shift 2 ;;
      --notify) notify=${2:?--notify needs a pane id}; named=1; shift 2 ;;
      --no-notify) notify=''; shift ;;
      --focus) focus=--focus; shift ;;
      --) shift; break ;;
      -*) die "unknown option $1" ;;
      *) break ;;
    esac
  done
  [ -z "$notify" ] || valid_id "$notify" || die "not a pane id: $notify"

  require herdr
  require jq
  workspace=$(workspace_of "$workspace")
  [ -n "$workspace" ] ||
    die "no workspace: pass --workspace, or run inside a herdr pane"

  local existing
  existing=$(review_pane "$workspace")
  if [ -n "$existing" ]; then
    go_to_review "$existing"
    return 0
  fi

  [ -n "$directory" ] || directory=$(workspace_cwd "$workspace")
  [ -n "$directory" ] || directory=$PWD

  # Where tuicr will file the session, which is not necessarily the directory
  # being opened -- see git_root.  The tab is still created on the directory
  # as given, because tuicr's own arguments are resolved against the pane's
  # working directory and moving it would silently repoint every relative
  # path a caller passed.
  local review_root
  review_root=$(git_root "$directory")
  [ -n "$review_root" ] || review_root=$directory

  # The pane comes from the environment and the directory from --cwd, so
  # nothing about a request makes the two agree.  Without this an agent is
  # woken about a project it is not working on, and a wake carries a session
  # file rather than a repository, so it reads exactly like its own review.
  #
  # Only a positive disagreement counts.  Either side being outside a
  # repository proves nothing about the other, and dropping the wake on a
  # guess costs the reviewer their reply.
  if [ -n "$notify" ] && [ -z "$named" ]; then
    local asking reviewing
    asking=$(git_identity "$(pane_cwd "$notify")")
    reviewing=$(git_identity "$directory")
    if [ -n "$asking" ] && [ -n "$reviewing" ] && [ "$asking" != "$reviewing" ]
    then
      notify=''
    fi
  fi

  local created pane tab
  created=$(herdr tab create --workspace "$workspace" --cwd "$directory" \
                             --label "$TAB_LABEL" "$focus")
  pane=$(printf '%s\n' "$created" | jq -r '.result.root_pane.pane_id')
  tab=$(printf '%s\n' "$created" | jq -r '.result.tab.tab_id')
  valid_id "$pane" || die "herdr returned no usable pane: $pane"
  valid_id "$tab" || die "herdr returned no usable tab: $tab"

  # Claimed here rather than left to the pane, which cannot claim it until
  # its shell has started, by which time a second caller would have opened
  # a review of its own.  The pane reports the state again when tuicr is
  # up.
  report_blocked "$pane"

  # Two callers can still pass the check above at the same instant, so the
  # claim is verified rather than trusted.  Everyone who claimed now sees
  # the same set and agrees on the oldest, so all but that one stand down.
  # A lock would need to survive a caller dying mid-claim; this does not.
  SNAPSHOT=
  local winner
  winner=$(review_pane "$workspace")
  if [ -n "$winner" ] && [ "$winner" != "$pane" ]; then
    release "$pane"
    herdr tab close "$tab" >/dev/null 2>&1 || true
    go_to_review "$winner"
    return 0
  fi

  # Arguments given win: someone naming a range means that range, not
  # whatever is unreviewed.  With none, show what has arrived since the
  # last review, or since the branch point before there has been one.
  local -a review_args=("$@")
  if [ ${#review_args[@]} -eq 0 ]; then
    mapfile -t review_args < <(unreviewed_args "$directory")
  fi
  mark_reviewed "$directory" >/dev/null

  local command
  printf -v command '%q host %q %q' "$(self)" "$tab" "$pane"
  [ -z "$notify" ] || command+=$(printf ' --notify %q' "$notify")
  if [ ${#review_args[@]} -gt 0 ]; then
    command+=' --'
    command+=$(printf ' %q' "${review_args[@]}")
  fi
  herdr pane run "$pane" "$command" >/dev/null

  # An empty review is worth saying out loud.  tuicr quits at once when it
  # is given nothing, which closes the tab and releases the pane, so a
  # caller that only read "reused": false would report a review waiting
  # that had already gone.
  local summary empty=false
  summary=$(changed_summary "$directory" "${review_args[@]}")
  if [ "$summary" = 'nothing to review' ]; then
    empty=true
    # An empty review in a dirty checkout is one mistake, not two: the work
    # is there but uncommitted, and reviews show committed work. Saying so
    # beats leaving the caller to wonder where their change went.
    if dirty_tree "$directory"; then
      summary='nothing committed to review: commit the work first'
    fi
  fi
  # The root rather than the directory opened: this is the value a caller
  # needs to find the session again, and tuicr will only answer to the path it
  # filed one under.
  jq -n --arg pane "$pane" --arg tab "$tab" --arg cwd "$review_root" \
        --arg summary "$summary" \
        --argjson empty "$empty" \
        --argjson notified "$([ -n "$notify" ] && printf true || printf false)" \
    '{pane_id: $pane, tab_id: $tab, cwd: $cwd, reused: false,
      summary: $summary, empty: $empty, notified: $notified}'
}

cmd_close() {
  local workspace=''
  while [ $# -gt 0 ]; do
    case $1 in
      --workspace) workspace=${2:?--workspace needs an id}; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done

  require herdr
  require jq
  workspace=$(workspace_of "$workspace")
  [ -n "$workspace" ] || die "no workspace: pass --workspace"

  local pane
  pane=$(review_pane "$workspace")
  if [ -z "$pane" ]; then
    jq -n '{closed: false}'
    return 0
  fi

  local tab
  tab=$(tab_of_pane "$pane")
  release "$pane"
  [ -n "$tab" ] && herdr tab close "$tab" >/dev/null 2>&1 || true
  jq -n --arg pane "$pane" --arg tab "$tab" '{pane_id: $pane, tab_id: $tab, closed: true}'
}

cmd_status() {
  local workspace=''
  while [ $# -gt 0 ]; do
    case $1 in
      --workspace) workspace=${2:?--workspace needs an id}; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done

  require herdr
  require jq
  workspace=$(workspace_of "$workspace")
  [ -n "$workspace" ] || die "no workspace: pass --workspace"

  snapshot | jq --arg ws "$workspace" --arg kind "$AGENT_KIND" '
    first(.result.snapshot.agents[]
          | select(.workspace_id == $ws and .agent == $kind)) // {}'
}

go_to_review() {
  # Focus an existing review and report it as the answer.  Through the
  # agent rather than the pane: `pane focus' moves in a direction, while a
  # review is a place to go to.
  # The reply carries cwd like the opening one does, so that a caller
  # holding on to it — to find the review session afterwards — does not
  # have to care whether it opened the review or found it.
  #
  # It is never notified.  The running review wakes whoever opened it, and
  # that is not this caller: a second agent sent to an existing review has
  # to find out how it went for itself, and is told so here rather than
  # waiting for a message addressed to someone else.
  local pane=$1
  herdr agent focus "$pane" >/dev/null
  jq -n --arg pane "$pane" --arg tab "$(tab_of_pane "$pane")" \
        --arg cwd "$(pane_cwd "$pane")" \
    '{pane_id: $pane, tab_id: $tab, cwd: $cwd, reused: true, notified: false}'
}

pane_cwd() {
  local pane=$1
  snapshot | jq -r --arg pane "$pane" '
    first(.result.snapshot.panes[]
          | select(.pane_id == $pane)
          | .cwd) // empty'
}

report_blocked() {
  local pane=$1
  herdr pane report-agent "$pane" --source "$SOURCE" --agent "$AGENT_KIND" \
    --state blocked --message "waiting for review" >/dev/null
}

cmd_marks() {
  local directory=${1:-$PWD}
  require git
  require jq
  git_repo "$directory" || die "not a git repository: $directory"
  git -C "$directory" for-each-ref --format='%(refname) %(objectname)' \
    refs/reviews |
    jq -Rs --arg head "$(git -C "$directory" rev-parse HEAD 2>/dev/null)" '
      split("\n")
      | map(select(length > 0) | split(" "))
      | {head: $head,
         marks: map({mark: (.[0] | sub("^refs/reviews/"; "")), commit: .[1]})}'
}

release() {
  local pane=$1
  herdr pane release-agent "$pane" --source "$SOURCE" --agent "$AGENT_KIND" \
    >/dev/null 2>&1 || true
}

cmd_host() {
  local tab=${1:?host needs a tab id} pane=${2:?host needs a pane id}
  shift 2
  local notify=''
  while [ $# -gt 0 ]; do
    case $1 in
      --notify) notify=${2:?--notify needs a pane id}; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  require herdr
  valid_id "$pane" || die "not a pane id: $pane"
  valid_id "$tab" || die "not a tab id: $tab"
  [ -z "$notify" ] || valid_id "$notify" || die "not a pane id: $notify"

  # Armed before anything that can fail, so that a review which never
  # starts frees the workspace as surely as one the operator finishes.
  # On any exit, including an interrupt: hand the pane back and take the
  # tab away.  Expanded now rather than at exit, because these are locals
  # and an EXIT trap does not run inside the function that set it.  What
  # the trap needs is held in globals for the same reason.
  HOST_PANE=$pane
  HOST_TAB=$tab
  trap release_host EXIT

  require tuicr

  # Decided once, so that the row and the TUI answer for the same review.
  local -a review_args=("$@")
  [ ${#review_args[@]} -gt 0 ] || review_args=(--working-tree)

  report_blocked "$pane"
  # No display name: the agent kind already reads as "review", and a
  # display name repeating it would only be one more thing to keep in
  # step with it.
  herdr pane report-metadata "$pane" --source "$SOURCE" \
    --token "summary=$(changed_summary "$PWD" "${review_args[@]}")" >/dev/null

  # Beside the TUI rather than after it, because the point is to reach the
  # agent while the reviewer is still writing.  Its stderr goes nowhere:
  # this pane belongs to tuicr, and a background job complaining into it
  # would be painted over the diff the operator is reading.
  if [ -n "$notify" ]; then
    HOST_NOTIFY=$notify
    HOST_SESSION_FILE=$(mktemp "${TMPDIR:-/tmp}/herdr-meat-review-session-XXXXXX")
    cmd_watch --notify "$notify" --cwd "$PWD" \
              --session-file "$HOST_SESSION_FILE" 2>/dev/null &
    HOST_WATCHER=$!
  fi

  tuicr "${review_args[@]}"
}

HOST_PANE=
HOST_TAB=
HOST_NOTIFY=
HOST_WATCHER=
HOST_SESSION_FILE=

release_host() {
  # On any exit, including an interrupt: stop watching, tell the agent the
  # review is over, hand the pane back, and take the tab away.
  #
  # The wake goes here rather than in the watcher because a review does not
  # always end with the reviewer quitting.  `close' takes the tab away, and
  # a watcher waiting to report that would be killed before it could.
  [ -z "$HOST_WATCHER" ] || kill "$HOST_WATCHER" 2>/dev/null || true
  # The root rather than the pane's own directory, so that the agent is told
  # the checkout the session was filed under and can ask tuicr about it.
  local watched=$PWD root
  root=$(git_root "$PWD")
  [ -z "$root" ] || watched=$root
  wake_closed "$HOST_NOTIFY" "$(session_seen)" "$watched"
  release "$HOST_PANE"
  herdr tab close "$HOST_TAB" >/dev/null 2>&1 || true
  [ -z "$HOST_SESSION_FILE" ] || rm -f "$HOST_SESSION_FILE"
}

session_seen() {
  # The session the watcher bound to, if it ever found one.
  [ -n "$HOST_SESSION_FILE" ] || return 0
  cat "$HOST_SESSION_FILE" 2>/dev/null || true
}

main() {
  local command=${1:-}
  [ $# -gt 0 ] && shift || true
  case $command in
    open) cmd_open "$@" ;;
    close) cmd_close "$@" ;;
    status) cmd_status "$@" ;;
    marks) cmd_marks "$@" ;;
    watch) cmd_watch "$@" ;;
    host) cmd_host "$@" ;;
    version | --version | -V) version ;;
    -h | --help | help | '') usage ;;
    *) die "unknown command $command" ;;
  esac
}

main "$@"
